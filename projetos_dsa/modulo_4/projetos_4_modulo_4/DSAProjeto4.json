    {
      "parameters": {
        "jsCode": "// Loop sobre os resultados do node anterior para gerar o output com os tweets no formato JSON\noutput = []\nmax_posts = 10\nlet counter = 0\nfor (const item of $input.all()[0].json.tweets) {\n if(!item.content.hasOwnProperty('itemContent')) continue\n let post = {\n text: item.content.itemContent?.tweet_results?.result.legacy?.full_text\n }\n console.log(post)\n output.push(post)\n if(counter++ >= max_posts) break;\n}\n\nreturn {\"Twitter tweets\": output};"
      },
      "id": "2f0748f5-5a02-42c0-8820-3666b6d4f9cd",
      "name": "Processamento de Dados 1",
      "type": "n8n-nodes-base.code",
      "position": [
