        624
      ],
      "typeVersion": 2,
      "notes": "DSA Log - Node com código JavaScript para processar o resultado da extração dos tweets e ajustar os dados para o formato JSON."
    },
    {
      "parameters": {
        "jsCode": "// Loop sobre os resultados do node anterior para gerar o output com os posts do LinkedIn no formato JSON\noutput = []\nmax_posts = 10\nlet counter = 0\nfor (const item of $input.all()[0].json.data) {\n let post = {\n title: item.article_title,\n text: item.text\n }\n output.push(post)\n if(counter++ >= max_posts) break;\n}\n\nreturn {\"linkedIn posts\": output};"
      },
